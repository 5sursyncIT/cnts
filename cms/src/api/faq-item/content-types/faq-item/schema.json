{
  "kind": "collectionType",
  "collectionName": "faq_items",
  "info": {
    "singularName": "faq-item",
    "pluralName": "faq-items",
    "displayName": "Question FAQ",
    "description": "Questions fréquentes de la page /faq, groupées par catégorie."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true,
      "maxLength": 300
    },
    "answer": {
      "type": "text",
      "required": true
    },
    "category": {
      "type": "string",
      "required": true,
      "default": "Général",
      "maxLength": 80
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
