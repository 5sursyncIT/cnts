POSTGRES_USER=cnts
POSTGRES_PASSWORD=cnts
POSTGRES_DB=cnts

CNTS_ENV=dev
CNTS_LOG_LEVEL=INFO
CNTS_DATABASE_URL=postgresql+psycopg://cnts:cnts@db:5432/cnts
CNTS_CNI_HASH_KEY=change-me
CNTS_DIN_SITE_CODE=CNTS
CNTS_FRACTIONNEMENT_MAX_OVERAGE_ML=250

# Relais SMTP autorisé par IP : aucune authentification
CNTS_SMTP_HOST=smtp-appli1.sec.gouv.sn
CNTS_SMTP_PORT=25
CNTS_SMTP_SENDER=noreply-cnts@gouv.sn

# CMS Strapi (service cms) — générer chaque secret avec `openssl rand -base64 32`
CMS_PUBLIC_URL=https://cnts.gouv.sn/cms
CMS_DB_NAME=strapi
CMS_DB_USER=strapi
CMS_DB_PASSWORD=change-me
CMS_APP_KEYS=key1,key2,key3,key4
CMS_API_TOKEN_SALT=change-me
CMS_ADMIN_JWT_SECRET=change-me
CMS_JWT_SECRET=change-me
CMS_TRANSFER_TOKEN_SALT=change-me
CMS_ENCRYPTION_KEY=change-me

# Portail : signature des sessions de l espace patient (openssl rand -hex 32)
PORTAL_SESSION_SECRET=change-me

# SMS via Brevo (provisoire, en attendant un opérateur local). Clé : Brevo > SMTP & API > Clés API.
# Expéditeur : 11 caractères alphanumériques max.
CNTS_SMS_API_KEY=
CNTS_SMS_SENDER=CNTS
